load("@rules_java//java:defs.bzl", "java_library", "java_plugin")

java_plugin(
    name = "truffle_processor",
    processor_class = "com.oracle.truffle.dsl.processor.TruffleProcessor",
    deps = ["@maven//:org_graalvm_truffle_truffle_dsl_processor"],
)

java_plugin(
    name = "language_processor",
    processor_class = "com.oracle.truffle.dsl.processor.LanguageRegistrationProcessor",
    deps = ["@maven//:org_graalvm_truffle_truffle_dsl_processor"],
)

java_plugin(
    name = "instrumentable_processor",
    processor_class = "com.oracle.truffle.dsl.processor.InstrumentableProcessor",
    deps = ["@maven//:org_graalvm_truffle_truffle_dsl_processor"],
)

java_library(
    name = "trufflecel",
    srcs = [
        "Activation.java",
        "Ast.java",
        "BorrowedBindings.java",
        "Bytes.java",
        "Cel.java",
        "CelException.java",
        "CelLanguage.java",
        "CelNode.java",
        "CelNull.java",
        "CelType.java",
        "Checker.java",
        "ComprehensionNode.java",
        "ConfigurationData.java",
        "CostEstimator.java",
        "CseOptimizer.java",
        "DataType.java",
        "DataValues.java",
        "EncoderFunctions.java",
        "Environment.java",
        "EnvironmentYaml.java",
        "EvalContext.java",
        "EvaluationOptions.java",
        "EvaluationResult.java",
        "EvaluationState.java",
        "ExprNode.java",
        "ExtensionFunctions.java",
        "FieldPlan.java",
        "FunctionOverloads.java",
        "Functions.java",
        "GuestException.java",
        "GuestValue.java",
        "HostCollections.java",
        "LibraryPolicy.java",
        "Macro.java",
        "NetworkValue.java",
        "ObjectType.java",
        "Optimizer.java",
        "OptionalValue.java",
        "Parser.java",
        "PolicyCompiler.java",
        "PreparedProgram.java",
        "Program.java",
        "Regex.java",
        "TraceEvent.java",
        "TraceListener.java",
        "TracedProgram.java",
        "TypeSyntax.java",
        "UInt.java",
        "Unknown.java",
        "Unparser.java",
        "Validator.java",
        "Values.java",
        "WellKnownTypes.java",
        "WriteNode.java",
    ],
    plugins = [
        ":truffle_processor",
        ":language_processor",
        ":instrumentable_processor",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_re2j_re2j",
        "@maven//:dev_elide_truffledata_core",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_snakeyaml_snakeyaml_engine",
    ],
)

java_library(
    name = "json",
    srcs = ["JsonValues.java"],
    visibility = ["//visibility:public"],
    deps = [
        ":trufflecel",
        "@maven//:org_graalvm_shadowed_json",
    ],
)

java_library(
    name = "protobuf",
    srcs = [
        "CanonicalAst.java",
        "ProtobufType.java",
        "//third_party/cel-spec/proto:schema_java",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":trufflecel",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:dev_elide_truffledata_core",
        "@maven//:dev_elide_truffledata_protobuf",
        "@maven//:dev_elide_truffledata_protobuf_runtime",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)
