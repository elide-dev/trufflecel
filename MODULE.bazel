module(name = "trufflecel", version = "0.1.0")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.graalvm.truffle:truffle-api:25.5.5-elide.5",
        "org.graalvm.truffle:truffle-dsl-processor:25.5.5-elide.5",
        "org.graalvm.polyglot:polyglot:25.5.5-elide.5",
        "org.graalvm.truffle:truffle-runtime:25.5.5-elide.5",
        "org.graalvm.sdk:nativeimage:25.5.5-elide.5",
        "com.google.re2j:re2j:1.8",
        "dev.elide:truffledata-core:0.1.0-alpha.4",
        "dev.elide:truffledata-protobuf:0.1.0-alpha.4",
        "dev.elide:truffledata-jdbc:0.1.0-alpha.4",
        "org.graalvm.shadowed:json:25.5.5-elide.5",
        "com.google.protobuf:protobuf-java:4.36.1",
        "com.h2database:h2:2.3.232",
        "junit:junit:4.13.2",
        "com.google.code.gson:gson:2.13.2",
        "com.google.googlejavaformat:google-java-format:1.28.0",
    ],
    repositories = ["https://repo.maven.apache.org/maven2", "https://maven.elide.dev", "https://maven.elide.dev/gvm-elide/25.5.5-elide.5"],
    lock_file = "//:maven_install.json",
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
)
use_repo(maven, "maven")

bazel_dep(name = "gazelle", version = "0.47.0", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.59.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.0.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.25.3")

bazel_dep(name = "rules_cc", version = "0.2.26")
register_toolchains("//bazel/platforms:cc_toolchain")

# Benchmark-only Native Image toolchain and pinned CodSpeed region hooks.
bazel_dep(name = "rules_graalvm", version = "0.12.0")
git_override(
    module_name = "rules_graalvm",
    commit = "69b645681f8dce07c0dc3a94dc8f4b99e1d1ba9c",
    remote = "https://github.com/sgammon/rules_graalvm.git",
)
gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
gvm.graalvm(
    name = "graalvm_linux_amd64",
    distribution = "ce",
    java_version = "25",
    platform = "linux-x64",
    version = "25.5.5-elide.5",
    sha256s = {"linux-x64": "af2bd180962d498217da2146b7a9653b5bb9d0ba5ffa9dae5a4de42f6685105d"},
    strip_prefixes = {"linux-x64": "graalvm-ce-25.5.5-elide.5-linux-amd64"},
    urls = {"linux-x64": "https://maven.elide.dev/gvm-elide/25.5.5-elide.5/dist/graalvm-ce-25.5.5-elide.5-linux-amd64.tar.gz"},
)
use_repo(gvm, "graalvm_linux_amd64", "graalvm_linux_amd64_toolchains")
register_toolchains("@graalvm_linux_amd64_toolchains//:all")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "codspeed_hooks",
    build_file = "//bazel:codspeed_hooks.BUILD",
    sha256 = "a1a486756f307e3dfe42518784a9d8d29217878c5e36a9ebe72d3e5a89150bda",
    strip_prefix = "instrument-hooks-1ec92c8c9db59db2d0adc37f47d003d3db4e1c64",
    urls = ["https://codeload.github.com/CodSpeedHQ/instrument-hooks/tar.gz/1ec92c8c9db59db2d0adc37f47d003d3db4e1c64"],
    type = "tar.gz",
)
