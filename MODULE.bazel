# Maven release versions come from VERSION; this root module is not published to a Bazel registry.
module(name = "trufflecel")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.graalvm.truffle:truffle-api:25.5.5-elide.28",
        "org.graalvm.truffle:truffle-dsl-processor:25.5.5-elide.28",
        "org.graalvm.polyglot:polyglot:25.5.5-elide.28",
        "org.graalvm.truffle:truffle-runtime:25.5.5-elide.28",
        "org.graalvm.regex:regex:25.5.5-elide.28",
        "org.graalvm.sdk:nativeimage:25.5.5-elide.28",
        "com.google.re2j:re2j:1.8",
        "dev.elide:truffledata-core:0.11.0",
        "dev.elide:truffledata-protobuf:0.11.0",
        "dev.elide:truffledata-protobuf-runtime:0.11.0",
        "dev.elide:truffledata-jdbc:0.11.0",
        "org.graalvm.shadowed:json:25.5.5-elide.28",
        "com.google.protobuf:protobuf-java:4.36.2",
        "com.h2database:h2:2.5.252",
        "junit:junit:4.13.2",
        "com.google.code.gson:gson:2.15.0",
        "org.snakeyaml:snakeyaml-engine:3.2",
        "io.grpc:grpc-netty-shaded:1.85.1",
        "io.grpc:grpc-protobuf:1.85.1",
        "io.grpc:grpc-stub:1.85.1",
        "com.google.googlejavaformat:google-java-format:1.37.0",
    ],
    repositories = ["https://repo.maven.apache.org/maven2", "https://maven.elide.dev", "https://maven.elide.dev/gvm-elide/25.5.5-elide.28"],
    lock_file = "//:maven_install.json",
    version_conflict_policy = "pinned",
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
)
use_repo(maven, "maven")

# Upstream CEL is comparison-only; keep its dependency graph out of production resolution.
maven.install(
    name = "cel_java",
    lock_file = "//:cel_java_install.json",
    artifacts = ["dev.cel:cel:0.15.0", "org.openjdk.jmh:jmh-core:1.37", "org.openjdk.jmh:jmh-generator-annprocess:1.37"],
    repositories = ["https://repo.maven.apache.org/maven2"],
    fail_if_repin_required = True,
)
use_repo(maven, "cel_java")

# Fuzzing tools have their own resolution and never enter publication dependencies.
maven.install(
    name = "fuzzing",
    artifacts = ["com.code-intelligence:jazzer:0.30.0", "com.code-intelligence:jazzer-api:0.30.0"],
    repositories = ["https://repo.maven.apache.org/maven2"],
    lock_file = "//:fuzzing_install.json",
    fail_if_repin_required = True,
)
use_repo(maven, "fuzzing")

bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.65.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.26.7")

bazel_dep(name = "rules_cc", version = "0.2.28")
register_toolchains("//bazel/platforms:cc_toolchain")

# Pinned GraalVM JVM/Native Image toolchains for compilation gates and benchmarks.
bazel_dep(name = "rules_graalvm", version = "0.12.0")
git_override(
    module_name = "rules_graalvm",
    commit = "69b645681f8dce07c0dc3a94dc8f4b99e1d1ba9c",
    remote = "https://github.com/sgammon/rules_graalvm.git",
)
gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
gvm.graalvm(
    name = "graalvm_linux_amd64",
    toolchain_prefix = "graalvm",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    distribution = "ce",
    java_version = "25",
    platform = "linux-x64",
    version = "25.5.5-elide.28",
    sha256s = {"linux-x64": "398d8587d0ac7ab2610a979cdc43f0ad03a484b4be0e09a1bcc64f2ec703f148"},
    strip_prefixes = {"linux-x64": "graalvm-ce-25.5.5-elide.28-linux-amd64"},
    urls = {"linux-x64": "https://maven.elide.dev/gvm-elide/25.5.5-elide.28/dist/graalvm-ce-25.5.5-elide.28-linux-amd64.tar.gz"},
)
gvm.graalvm(
    name = "graalvm_macos_aarch64",
    toolchain_prefix = "graalvm",
    target_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    distribution = "ce",
    java_version = "25",
    platform = "macos-aarch64",
    version = "25.5.5-elide.28",
    sha256s = {"macos-aarch64": "8a244c653dc7875c72efbb8e1a42b5dd8e11fe73e616beb6b84e598ab170b207"},
    strip_prefixes = {"macos-aarch64": "graalvm-ce-25.5.5-elide.28-macos-aarch64"},
    urls = {"macos-aarch64": "https://maven.elide.dev/gvm-elide/25.5.5-elide.28/dist/graalvm-ce-25.5.5-elide.28-macos-aarch64.tar.gz"},
)
use_repo(gvm, "graalvm_linux_amd64", "graalvm_linux_amd64_toolchains", "graalvm_macos_aarch64", "graalvm_macos_aarch64_toolchains")
register_toolchains("@graalvm_macos_aarch64_toolchains//:all")
register_toolchains("@graalvm_linux_amd64_toolchains//:all")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "codspeed_hooks",
    build_file = "//bazel:codspeed_hooks.BUILD",
    sha256 = "a1a486756f307e3dfe42518784a9d8d29217878c5e36a9ebe72d3e5a89150bda",
    strip_prefix = "instrument-hooks-1ec92c8c9db59db2d0adc37f47d003d3db4e1c64",
    urls = ["https://codeload.github.com/CodSpeedHQ/instrument-hooks/tar.gz/1ec92c8c9db59db2d0adc37f47d003d3db4e1c64"],
    type = "tar.gz",
)
