alias(name = "trufflecel", actual = "//src/main/java/dev/trufflecel:trufflecel", visibility = ["//visibility:public"])

alias(name = "gazelle", actual = "//bazel/gazelle:update", tags = ["manual"])

exports_files(["maven_install.json", "cel_java_install.json", "fuzzing_install.json", "LICENSE", "LICENSE-MIT", "LICENSE-APACHE", "NOTICE"])

alias(name = "trufflecel-protobuf", actual = "//src/main/java/dev/trufflecel:protobuf", visibility = ["//visibility:public"])
alias(name = "trufflecel-json", actual = "//src/main/java/dev/trufflecel:json", visibility = ["//visibility:public"])

filegroup(
    name = "ci_sources",
    srcs = glob([".github/scripts/*.py", ".github/workflows/*.yml"]) + [
        "VERSION", "release-please-config.json", ".release-please-manifest.json",
        ".github/scripts/configure-buildbuddy.sh",
        ".bestpractices.json", "//tools:best-practices.py", "//tools:best-practices-criteria.json",
        "//tools/release:maven_repo.py", "//tools/release:dependency_gate.py",
    ],
    visibility = ["//visibility:public"],
)

alias(name = "trufflecel-processor", actual = "//src/main/java/dev/trufflecel/processor:processor", visibility = ["//visibility:public"])
