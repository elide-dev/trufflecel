load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:simulation.bzl", "simulation_image")
java_library(
    name = "benchmarks",
    srcs = ["NativeHooks.java", "SimulationBenchmark.java"],
    deps = ["//:trufflecel", "//:trufflecel-protobuf", "//:trufflecel-json",
            "@maven//:dev_elide_truffledata_core", "@maven//:com_google_protobuf_protobuf_java",
            "@maven//:org_graalvm_sdk_nativeimage", "@maven//:org_graalvm_shadowed_json"],
)
java_test(
    name = "smoke", main_class = "dev.trufflecel.bench.SimulationBenchmark",
    args = ["--smoke"], use_testrunner = False, runtime_deps = [":benchmarks"],
)
native_image(
    name = "native",
    cc_deps = ["//benchmarks/native:hooks"],
    data = ["//benchmarks/native:celbench.h"],
    debug = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB", "EstimatedFreeDiskBytes": "16GB"},
    executable_name = "trufflecel-bench",
    extra_args = ["--gc=serial", "-Dtruffle.UseFallbackRuntime=true", "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata",
                  "--initialize-at-run-time=dev.trufflecel.bench", "--parallelism=8", "-march=compatibility",
                  "-H:+UnlockExperimentalVMOptions", "-H:-DeleteLocalSymbols", "-H:+PreserveFramePointer",
                  "-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.trufflecel.bench.SimulationBenchmark",
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    deps = [":benchmarks", "@maven//:org_graalvm_truffle_truffle_runtime"],
)
simulation_image(name = "simulation", image = ":native", tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
filegroup(name = "native_debug", srcs = [":native"], output_group = "debug_files", tags = ["manual"])
sh_test(name = "native_smoke", srcs = ["native_smoke.sh"], args = ["$(rootpath :simulation)"],
    data = [":simulation"], tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
exports_files(["cases.json"])

java_test(
    name = "compiled",
    exec_properties = {"EstimatedCPU": "2", "EstimatedMemory": "4GB"},
    srcs = ["CompiledTest.java"],
    test_class = "dev.trufflecel.CompiledTest",
    size = "medium",
    jvm_flags = ["-ea", "-Xbatch", "-XX:-UseJVMCICompiler", "--enable-native-access=ALL-UNNAMED"],
    deps = ["//:trufflecel", "@maven//:junit_junit", "@maven//:org_graalvm_truffle_truffle_api",
            "@maven//:org_graalvm_truffle_truffle_runtime", "@maven//:org_graalvm_polyglot_polyglot",
            "@maven//:dev_elide_truffledata_core", "//:trufflecel-protobuf", "//:trufflecel-json",
            "@maven//:com_google_protobuf_protobuf_java", "@maven//:org_graalvm_shadowed_json"],
)

# Every evaluation-phase negative case through forced last-tier guest compilation.
java_test(
    name = "negative_compiled",
    exec_properties = {"EstimatedCPU": "2", "EstimatedMemory": "4GB"},
    srcs = ["NegativeCompiledTest.java"],
    data = ["//third_party/cel-spec:schemas.json"],
    test_class = "dev.trufflecel.NegativeCompiledTest",
    size = "large",
    # The runtime listener's signatures reference compiler types that the named module keeps.
    jvm_flags = ["-ea", "-Xbatch", "-XX:-UseJVMCICompiler", "--enable-native-access=ALL-UNNAMED",
                 "--add-exports=org.graalvm.truffle.compiler/com.oracle.truffle.compiler=ALL-UNNAMED"],
    deps = ["//:trufflecel", "//:trufflecel-protobuf", "//src/test/java/dev/trufflecel:test_support",
            "@maven//:junit_junit", "@maven//:org_graalvm_truffle_truffle_api",
            "@maven//:org_graalvm_truffle_truffle_runtime", "@maven//:org_graalvm_polyglot_polyglot"],
)

# The simulation remains deterministic AOT; this independent gate includes the guest compiler.
java_library(
    name = "jit_support",
    testonly = True,
    srcs = ["JitSmoke.java"],
    deps = [":benchmarks", "//:trufflecel", "//:trufflecel-protobuf", "@maven//:com_google_protobuf_protobuf_java", "@maven//:org_graalvm_truffle_truffle_api", "@maven//:org_graalvm_truffle_truffle_runtime",
            "@maven//:org_graalvm_polyglot_polyglot"],
)
native_image(
    name = "native_jit",
    testonly = True,
    cc_deps = ["//benchmarks/native:hooks"],
    data = ["//benchmarks/native:celbench.h"],
    debug = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB", "EstimatedFreeDiskBytes": "16GB"},
    executable_name = "trufflecel-jit",
    extra_args = ["--gc=serial", "-J-Xmx4g",
                  "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED", "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata,com.google.protobuf",
                  "--initialize-at-run-time=dev.trufflecel.bench", "--parallelism=4", "-march=compatibility",
                  "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-DeleteLocalSymbols", "-H:+PreserveFramePointer",
                  "-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.trufflecel.JitSmoke",
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    deps = [":jit_support", "@maven//:org_graalvm_truffle_truffle_runtime"],
)
sh_test(
    name = "jit_smoke",
    exec_properties = {"EstimatedCPU": "2", "EstimatedMemory": "4GB"},
    srcs = ["jit_smoke.sh"],
    args = ["$(rootpath :native_jit)"],
    data = [":native_jit"],
    size = "large",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
