sh_test(name = "prepared_native_smoke", srcs = ["prepared_native_smoke.sh"], args = ["$(rootpath :prepared_svm)"], data = [":prepared_svm"], tags = ["manual"], size = "large", target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

# Complete process startup, separate from Lifecycle's post-fixture clock.
java_library(name = "startup_lib", testonly = True, srcs = ["Startup.java", "StartupPrepared.java", "StartupImageMode.java"],
    deps = [":engines", ":policy_java", "//:trufflecel", "//:trufflecel-protobuf",
            "@cel_java//:com_google_protobuf_protobuf_java", "@cel_java//:dev_cel_common",
            "@cel_java//:dev_cel_runtime", "@maven//:org_graalvm_sdk_nativeimage",
            "@maven//:com_google_code_gson_gson", "@maven//:org_graalvm_truffle_truffle_runtime"])
java_binary(name = "startup", testonly = True, main_class = "dev.trufflecel.Startup", runtime_deps = [":startup_lib"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED", "-XX:-UseJVMCICompiler", "-Xms512m", "-Xmx512m"])
sh_test(name = "startup_smoke", srcs = ["startup_smoke.sh"], args = ["$(rootpath :startup)"], data = [":startup"], size = "large")
# Keep build-time prepared adapters/ASTs out of the runtime-prepared image heap.
[native_image(
    name = "startup_" + mode + "svm", testonly = True, executable_name = "startup-" + mode.replace("_", "-") + "representative",
    main_class = "dev.trufflecel.Startup", deps = [":startup_lib", ":native_config"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    extra_args = ["--gc=serial", "-J-Xmx6g", "--parallelism=4", "-march=compatibility",
        "--features=dev.trufflecel.UpstreamProtobufFeature",
        "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
        "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata,dev.cel,org.antlr.v4,com.google.common,com.google.protobuf,com.google.re2j",
        "--initialize-at-run-time=dev.trufflecel.Startup,dev.trufflecel.Workloads$$Raw,dev.trufflecel.Workloads$$Native" +
            (",dev.trufflecel.StartupPrepared" if mode == "" else ""),
        "-Dtrufflecel.startup.imagePrepared=" + ("false" if mode == "" else "true"),
        "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
) for mode in ["", "prepared_"]]
[sh_test(name = "startup_native_" + mode + "_smoke", srcs = ["startup_smoke.sh"],
    args = ["$(rootpath :startup_" + ("" if mode == "runtime" else "prepared_") + "svm)", mode],
    data = [":startup_" + ("" if mode == "runtime" else "prepared_") + "svm"], tags = ["manual"], size = "large",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
 for mode in ["runtime", "image"]]
