load("@rules_java//java:defs.bzl", "java_library", "java_binary", "java_test", "java_plugin")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("//bazel:proto_schema.bzl", "java_proto_sources")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

proto_library(name = "policy", testonly = True, srcs = ["policy.proto"], deps = ["@protobuf//:wrappers_proto", "@protobuf//:timestamp_proto"])
java_proto_library(name = "policy_generated", testonly = True, deps = [":policy"])
java_proto_sources(name = "policy_sources", testonly = True, library = ":policy_generated")
java_library(name = "policy_java", testonly = True, srcs = [":policy_sources"], deps = ["@cel_java//:com_google_protobuf_protobuf_java"])

java_library(
    name = "engines", testonly = True,
    srcs = ["Engines.java", "Workloads.java"],
    deps = [":policy_java", "//:trufflecel", "//:trufflecel-protobuf",
            "@cel_java//:com_google_protobuf_protobuf_java", "@maven//:org_graalvm_polyglot_polyglot",
            "@maven//:org_graalvm_truffle_truffle_runtime",
            "@cel_java//:dev_cel_cel", "@cel_java//:dev_cel_common", "@cel_java//:dev_cel_compiler", "@cel_java//:dev_cel_runtime"],
)
java_plugin(name = "jmh_generator", testonly = True, processor_class = "org.openjdk.jmh.generators.BenchmarkProcessor", deps = ["@cel_java//:org_openjdk_jmh_jmh_generator_annprocess"])
java_library(name = "jmh_benchmarks", testonly = True, srcs = ["SteadyState.java", "FrontendStages.java", "ActivationPreparation.java", "ActivationEvaluation.java", "StructuredAccess.java"], plugins = [":jmh_generator"], deps = [":engines", ":policy_java", "//:trufflecel", "@cel_java//:com_google_protobuf_protobuf_java", "@cel_java//:org_openjdk_jmh_jmh_core", "@cel_java//:dev_cel_common", "@cel_java//:dev_cel_compiler", "@cel_java//:dev_cel_runtime", "@cel_java//:dev_cel_cel"])
java_binary(name = "jmh", testonly = True, main_class = "org.openjdk.jmh.Main", runtime_deps = [":jmh_benchmarks", "@cel_java//:org_openjdk_jmh_jmh_core"], jvm_flags = ["--enable-native-access=ALL-UNNAMED"])
java_test(name = "smoke", testonly = True, srcs = ["Smoke.java"], main_class = "dev.trufflecel.Smoke", use_testrunner = False, deps = [":engines", "//:trufflecel"], jvm_flags = ["--enable-native-access=ALL-UNNAMED"])
java_test(name = "semantics", testonly = True, srcs = ["SemanticsTest.java"], test_class = "dev.trufflecel.SemanticsTest",
    deps = [":engines", "//:trufflecel", "@cel_java//:dev_cel_common", "@cel_java//:dev_cel_compiler", "@cel_java//:dev_cel_runtime", "@cel_java//:dev_cel_cel", "@maven//:junit_junit"])
java_library(name = "lifecycle_lib", testonly = True, srcs = ["Lifecycle.java", "ImagePrepared.java", "PreparedLifecycle.java"], deps = [":engines", ":policy_java", "@cel_java//:com_google_protobuf_protobuf_java", "//:trufflecel", "//:trufflecel-protobuf", "@maven//:org_graalvm_sdk_nativeimage", "@maven//:com_google_code_gson_gson", "@maven//:org_graalvm_truffle_truffle_runtime"])
java_binary(name = "lifecycle", testonly = True, main_class = "dev.trufflecel.Lifecycle", runtime_deps = [":lifecycle_lib"], jvm_flags = ["--enable-native-access=ALL-UNNAMED"])
java_library(name = "native_config", testonly = True, srcs = ["UpstreamProtobufFeature.java"], deps = [":policy_java", "@cel_java//:com_google_protobuf_protobuf_java", "@maven//:org_graalvm_sdk_nativeimage"])
native_image(
    name = "svm", testonly = True, executable_name = "representative",
    main_class = "dev.trufflecel.Lifecycle", deps = [":lifecycle_lib", ":native_config"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    extra_args = ["--gc=serial", "-J-Xmx6g", "--parallelism=4", "-march=compatibility",
        "--features=dev.trufflecel.UpstreamProtobufFeature",
        "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
        "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata,dev.cel,org.antlr.v4,com.google.common,com.google.protobuf,com.google.re2j",
        "--initialize-at-run-time=dev.trufflecel.Lifecycle",
        "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
sh_test(name = "native_smoke", srcs = ["native_smoke.sh"], args = ["$(rootpath :svm)"], data = [":svm"],
    tags = ["manual"], size = "large", target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

java_binary(name = "prepared_lifecycle", testonly = True, main_class = "dev.trufflecel.PreparedLifecycle", runtime_deps = [":lifecycle_lib"], jvm_flags = ["--enable-native-access=ALL-UNNAMED"])
native_image(
    name = "prepared_svm", testonly = True, executable_name = "prepared-representative",
    main_class = "dev.trufflecel.PreparedLifecycle", deps = [":lifecycle_lib", ":native_config"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    extra_args = ["--gc=serial", "-J-Xmx6g", "--parallelism=4", "-march=compatibility",
        "--features=dev.trufflecel.UpstreamProtobufFeature",
        "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
        "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata,dev.cel,org.antlr.v4,com.google.common,com.google.protobuf,com.google.re2j",
        "--initialize-at-run-time=dev.trufflecel.Lifecycle,dev.trufflecel.PreparedLifecycle",
        "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
sh_test(name = "prepared_native_smoke", srcs = ["prepared_native_smoke.sh"], args = ["$(rootpath :prepared_svm)"], data = [":prepared_svm"], tags = ["manual"], size = "large", target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
