        "--initialize-at-run-time=dev.trufflecel.EvaluationMemory",
        "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

java_binary(name = "prepared_lifecycle", testonly = True, main_class = "dev.trufflecel.PreparedLifecycle", runtime_deps = [":lifecycle_lib"], jvm_flags = ["--enable-native-access=ALL-UNNAMED"])
native_image(
    name = "prepared_svm", testonly = True, executable_name = "prepared-representative",
    main_class = "dev.trufflecel.PreparedLifecycle", deps = [":lifecycle_lib", ":native_config"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    extra_args = ["--gc=serial", "-J-Xmx6g", "--parallelism=4", "-march=compatibility",
        "--features=dev.trufflecel.UpstreamProtobufFeature",
        "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
        "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata,dev.cel,org.antlr.v4,com.google.common,com.google.protobuf,com.google.re2j",
        "--initialize-at-run-time=dev.trufflecel.Lifecycle,dev.trufflecel.PreparedLifecycle",
        "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    optimization_mode = "3", tags = ["manual"], workspace_tmp = True,
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
