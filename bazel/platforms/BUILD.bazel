package(default_visibility = ["//visibility:public"])

platform(
    name = "rbe_linux_amd64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:5d2d8b3935c4dad4d81e0b6d89eeb06734d0e708cdf3d8ec779cf619c9243860",
        "workload-isolation-type": "firecracker",
        "network": "off",
        "use-self-hosted-executors": "false",
        "EstimatedCPU": "2",
        "EstimatedMemory": "6GB",
    },
)

load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":cc_toolchain.bzl", "rbe_cc_config")

filegroup(name = "empty")
rbe_cc_config(name = "cc_config")
cc_toolchain(
    name = "cc",
    toolchain_identifier = "trufflecel-rbe-image-gcc",
    toolchain_config = ":cc_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
)
toolchain(
    name = "cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    toolchain = ":cc",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
