load("@rules_java//java:defs.bzl", "java_import", "java_plugin", "java_test", "java_library")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:maven.bzl", "maven_publication", "release_version")

release_version(
    name = "version",
    build_setting_default = "0.1.0-SNAPSHOT",
    visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "processor": [],
    "core": [
        "org.graalvm.polyglot:polyglot:25.5.5-elide.27",
        "org.graalvm.truffle:truffle-api:25.5.5-elide.27",
        "org.graalvm.regex:regex:25.5.5-elide.27",
        "dev.elide:truffledata-core:0.10.0",
        "com.google.re2j:re2j:1.8",
        "com.google.code.gson:gson:2.15.0",
        "org.snakeyaml:snakeyaml-engine:3.2",
    ],
    "protobuf": [
        "dev.elide:trufflecel-core:{version}",
        "org.graalvm.truffle:truffle-api:25.5.5-elide.27",
        "dev.elide:truffledata-core:0.10.0",
        "dev.elide:truffledata-protobuf:0.10.0",
        "dev.elide:truffledata-protobuf-runtime:0.10.0",
        "com.google.protobuf:protobuf-java:4.36.2",
    ],
    "json": [
        "dev.elide:trufflecel-core:{version}",
        "org.graalvm.shadowed:json:25.5.5-elide.27",
    ],
}

[maven_publication(
    name = module,
    dependencies = dependencies,
    optional_dependencies = ["com.google.re2j:re2j:1.8"] if module == "core" else [],
    library = "//:trufflecel" + ("" if module == "core" else "-" + module),
    module = module,
) for module, dependencies in DEPENDENCIES.items()]

filegroup(
    name = "publications",
    srcs = [":core", ":protobuf", ":json", ":processor"],
)

sh_test(
    name = "test",
    srcs = ["test.sh"],
    data = ["maven_repo.py", "test_release.py", ":publications", "//:maven_install.json", "//:LICENSE", "//:LICENSE-MIT", "//:LICENSE-APACHE", "//:NOTICE"],
)

[filegroup(
    name = module + "_binary",
    srcs = [":" + module],
    output_group = "binary",
) for module in DEPENDENCIES]

[java_import(
    name = module + "_import",
    jars = [":" + module + "_binary"],
    deps = [
        ":core_import" if coordinate.startswith("dev.elide:trufflecel-core:") else
        "@maven//:" + coordinate.split(":")[0].replace(".", "_").replace("-", "_") + "_" + coordinate.split(":")[1].replace("-", "_")
        for coordinate in dependencies
    ],
) for module, dependencies in DEPENDENCIES.items()]

java_plugin(
    name = "published_pojo_processor",
    processor_class = "dev.trufflecel.processor.PojoProcessor",
    deps = [":processor_import"],
)

java_test(
    name = "consumer_test",
    plugins = [":published_pojo_processor"],
    srcs = ["Consumer.java"],
    main_class = "Consumer",
    use_testrunner = False,
    deps = [
        ":core_import",
        ":protobuf_import",
        ":json_import",
        "@maven//:dev_elide_truffledata_core",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_shadowed_json",
        "@maven//:org_graalvm_polyglot_polyglot",
    ],
)

exports_files(["maven_repo.py", "dependency_gate.py"])

# Reconstruct the published consumer classpath without the optional compatibility JAR.
java_import(
    name = "core_without_re2j",
    jars = [":core_binary"],
    deps = ["@maven//:" + c.split(":")[0].replace(".", "_").replace("-", "_") + "_" + c.split(":")[1].replace("-", "_") for c in DEPENDENCIES["core"] if not c.startswith("com.google.re2j:")],
)
java_library(name = "no_re2j_consumer_lib", testonly = True, visibility = ["//src/test/java/dev/trufflecel:__pkg__"], srcs = ["NoRe2jConsumer.java"],
    deps = [":core_without_re2j", "@maven//:org_graalvm_polyglot_polyglot", "@maven//:org_graalvm_truffle_truffle_runtime"])
alias(name = "no_re2j_consumer", actual = "//src/test/java/dev/trufflecel:noRe2jConsumer")
native_image(name = "no_re2j_native", testonly = True, main_class = "dev.trufflecel.NoRe2jConsumer", executable_name = "no-re2j",
    deps = [":no_re2j_consumer_lib"], graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    extra_args = ["--gc=serial", "-J-Xmx4g", "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED", "--parallelism=4", "-march=compatibility", "--initialize-at-build-time=dev.trufflecel,dev.elide.truffledata", "-H:+UnlockExperimentalVMOptions", "-H:+TruffleCheckBlockListMethods", "-H:+TruffleCheckNeverPartOfCompilation", "-H:-UnlockExperimentalVMOptions"],
    exec_properties = {"EstimatedCPU":"8", "EstimatedMemory":"24GB"}, optimization_mode = "3", workspace_tmp = True,
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"], tags=["manual"])

sh_test(name = "no_re2j_native_smoke", srcs = ["no_re2j_native_smoke.sh"], args = ["$(rootpath :no_re2j_native)"], data = [":no_re2j_native"], tags=["manual"], size="large", target_compatible_with=["@platforms//os:linux", "@platforms//cpu:x86_64"])
