load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_java//java:defs.bzl", "java_binary")

java_binary(
    name = "coverage",
    srcs = ["java/dev/trufflecel/tools/CoverageCheck.java"],
    main_class = "dev.trufflecel.tools.CoverageCheck",
)

java_binary(
    name = "format",
    srcs = ["java/dev/trufflecel/tools/Format.java"],
    main_class = "dev.trufflecel.tools.Format",
    jvm_flags = ["--add-exports=jdk.compiler/com.sun.tools.javac.%s=ALL-UNNAMED" % package for package in ["api", "file", "parser", "tree", "util", "code"]],
    deps = ["@maven//:com_google_googlejavaformat_google_java_format"],
)

sh_binary(
    name = "embed_schema",
    srcs = ["embed_schema.py"],
    visibility = ["//visibility:public"],
)
