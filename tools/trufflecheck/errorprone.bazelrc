build:trufflecheck --javacopt=-Xep:TryWithResourcesVariable:WARN
build:trufflecheck --javacopt=-Xep:InsecureCryptoUsage:WARN
build:trufflecheck --javacopt=-Xep:CatchingUnchecked:WARN
build:trufflecheck --javacopt=-Xep:ReturnsNullCollection:WARN
build:trufflecheck --javacopt=-Xep:PreferredInterfaceType:WARN
build:trufflecheck --javacopt=-Xep:DepAnn:WARN
build:trufflecheck --javacopt=-Xep:EmptyIf:WARN
build:trufflecheck --javacopt=-Xep:FunctionalInterfaceClash:WARN
build:trufflecheck --javacopt=-Xep:LongLiteralLowerCaseSuffix:WARN
build:trufflecheck --javacopt=-Xep:RedundantThrows:WARN
build:trufflecheck --javacopt=-Xep:TestExceptionChecker:WARN
build:trufflecheck --javacopt=-Xep:ThrowsUncheckedException:WARN
build:trufflecheck --javacopt=-Xep:TransientMisuse:WARN
build:trufflecheck --javacopt=-Xep:UnnecessaryDefaultInEnumSwitch:WARN
build:trufflecheck --javacopt=-Xep:UseCorrectAssertInTests:WARN
build:trufflecheck --javacopt=-Xep:SwitchDefault:WARN
build:trufflecheck --javacopt=-Xep:NonApiType:OFF
build:trufflecheck --javacopt=-Xep:ArrayRecordComponent:OFF
build:trufflecheck --javacopt=-Xep:NotJavadoc:OFF
build:trufflecheck --javacopt=-Xep:EscapedEntity:OFF
build:trufflecheck --javacopt=-Xep:InvalidParam:OFF
build:trufflecheck --javacopt=-Xep:PatternMatchingInstanceof:OFF
build:trufflecheck --javacopt=-Xep:StatementSwitchToExpressionSwitch:OFF
build:trufflecheck --javacopt=-Xep:UnnecessaryParentheses:OFF
build:trufflecheck --javacopt=-Xep:StringConcatToTextBlock:OFF
build:trufflecheck --javacopt=-Xep:CanonicalDuration:OFF
build:trufflecheck --javacopt=-Xep:IfChainToSwitch:OFF
build:trufflecheck --javacopt=-Xep:RefactorSwitch:OFF
build:trufflecheck --javacopt=-Xep:UnnamedVariable:OFF
build:trufflecheck --javacopt=-Xep:EffectivelyPrivate:OFF
build:trufflecheck --javacopt=-Xep:AssignmentExpression:OFF
build:trufflecheck --javacopt=-Xep:BooleanLiteral:OFF
build:trufflecheck --javacopt=-Xep:ParameterMissingNullable:OFF
build:trufflecheck --javacopt=-Xep:FieldCanBeFinal:OFF
build:trufflecheck --javacopt=-XepExcludedPaths:.*/(generated|third_party|bazel-out)/.*
build:trufflecheck --javacopt=-XepOpt:Trufflecheck:Policy=tools/trufflecheck/trufflecheck.properties
build:trufflecheck --javacopt=-Xmaxwarns
build:trufflecheck --javacopt=100000
build:trufflecheck --javacopt=-Xmaxerrs
build:trufflecheck --javacopt=100000

build:trufflecheck_report --config=trufflecheck
build:trufflecheck_report --javacopt=-XepAllErrorsAsWarnings
build:trufflecheck_report --keep_going
